---
import InlineVideo from '../../components/InlineVideo.astro';
import Materials from '../../components/Materials.astro';
import Shot from '../../components/Shot.astro';
import Base from '../../layouts/Base.astro';
import { site } from '../../config/site';
import { modelName, models, type Model } from '../../lib/catalog';
import { containerCount, formatArea, formatBox, formatWeight } from '../../lib/format';
import { imageCaption, isImageId, type ImageId } from '../../lib/images';
import { page } from '../../lib/url';

const videoLabel: Record<string, string> = {
  'model-f20': 'Obhliadka modelu 20 ft. Video je bez zvuku.',
  'model-f30': 'Obhliadka modelu 30 ft. Video je bez zvuku.',
  'model-f40': 'Obhliadka modelu 40 ft. Video je bez zvuku.',
};

function plansFor(model: Model): { id: ImageId; alt: string }[] {
  const plans: { id: ImageId; alt: string }[] = [];
  if (isImageId(model.images.plan)) {
    plans.push({ id: model.images.plan, alt: `Pôdorys modelu ${modelName(model)}` });
  }
  if (isImageId(model.images.plan3d)) {
    plans.push({ id: model.images.plan3d, alt: `Priestorový pôdorys modelu ${modelName(model)}` });
  }
  return plans;
}
---

<Base
  title="Typy domov — Maximo"
  description="Modulárne domy 10 až 40 ft: rozmery, plocha, hmotnosť, dispozícia a počet kusov v kontajneri. Výber rámu, panelov, fasády, podláh, okien, kuchyne a kúpeľne."
>
  <main id="main" class="page">
    <div class="wrap">
      <header class="page-hero">
        <p class="eyebrow">Katalóg</p>
        <h1>Typy domov</h1>
        <p>
          Osem veľkostí. Rozmery, plocha a hmotnosť sú údaje z katalógu dodávateľa.
          Dispozícia sa dá pred objednávkou upraviť. Cenovú ponuku vám pripravíme na mieru.
        </p>
      </header>

      {
        models.map((model) => {
          const photo = isImageId(model.images.photo) ? model.images.photo : null;
          const video = model.images.video;
          const plans = plansFor(model);
          return (
            <article class="model-card" id={`model-${model.id}`}>
              <div class="model-media">
                {photo ? (
                  <figure>
                    <Shot id={photo} alt={`${modelName(model)}. ${imageCaption(photo)}`} group={`photo-${model.id}`} sizes="(min-width: 900px) 40vw, 100vw" />
                    <figcaption class="caption">{imageCaption(photo)}</figcaption>
                  </figure>
                ) : (
                  <div class="model-fallback" aria-hidden="true">
                    <span>{formatArea(model.area_m2)}</span>
                  </div>
                )}
                {video && (
                  <InlineVideo
                    id={video}
                    class="clip-model"
                    width={720}
                    height={1280}
                    label={videoLabel[video] ?? `Video modelu ${modelName(model)}. Video je bez zvuku.`}
                  />
                )}
              </div>
              <div>
                <h2>{modelName(model)}</h2>
                <p class="area">
                  {model.area_m2}
                  <small>m²</small>
                </p>
                <p class="layout">{model.layout_sk_draft}</p>
                <dl class="specs">
                  <div>
                    <dt>Rozmery rozloženého domu</dt>
                    <dd>{formatBox(model.expanded_mm)}</dd>
                  </div>
                  <div>
                    <dt>Zložený</dt>
                    <dd>{formatBox(model.folded_mm)}</dd>
                  </div>
                  <div>
                    <dt>Hmotnosť</dt>
                    <dd>{formatWeight(model.weight_t)}</dd>
                  </div>
                  <div>
                    <dt>Do kontajnera 40′ HC</dt>
                    <dd>{containerCount(model)}</dd>
                  </div>
                  <div>
                    <dt>Dispozícia</dt>
                    <dd>{model.layout_sk_draft}</dd>
                  </div>
                </dl>
                {plans.length > 0 && (
                  <div class="plans">
                    {plans.map((plan) => (
                      <Shot id={plan.id} alt={plan.alt} group={`plan-${model.id}`} sizes="180px" />
                    ))}
                  </div>
                )}
              </div>
            </article>
          );
        })
      }

      <section class="compare" aria-labelledby="compare-title">
        <div class="section-head">
          <h2 id="compare-title">Porovnanie</h2>
          <p class="scroll-hint">Na úzkej obrazovke posuňte tabuľku do strany.</p>
        </div>
        <div class="table-scroll" tabindex="0" role="region" aria-label="Porovnanie modelov, posúvateľné do strany">
          <table>
            <caption>Údaje rozloženého domu podľa katalógu dodávateľa. Dĺžka × šírka × výška.</caption>
            <thead>
              <tr>
                <th scope="col">Model</th>
                <th scope="col">Plocha</th>
                <th scope="col">Rozložený</th>
                <th scope="col">Zložený</th>
                <th scope="col">Hmotnosť</th>
                <th scope="col">V 40′ HC</th>
                <th scope="col">Dispozícia</th>
              </tr>
            </thead>
            <tbody>
              {
                models.map((model) => (
                  <tr>
                    <th scope="row">{modelName(model)}</th>
                    <td>{formatArea(model.area_m2)}</td>
                    <td>{formatBox(model.expanded_mm)}</td>
                    <td>{formatBox(model.folded_mm)}</td>
                    <td>{formatWeight(model.weight_t)}</td>
                    <td>{containerCount(model)}</td>
                    <td>{model.layout_sk_draft}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </section>
    </div>

    <Materials />

    <div class="wrap end-cta">
      <h2>Vyberieme model spolu</h2>
      <p>Cenovú ponuku vám pripravíme na mieru. Zavolajte a dohodnite obhliadku v Nebojsi.</p>
      <p class="cta-row">
        <a class="btn btn-solid" href={site.phone.href}>Zavolať {site.phone.display}</a>
        <a class="btn btn-ghost" href={page('/kontakt/', 'obhliadka')}>Dohodnúť obhliadku</a>
      </p>
    </div>
  </main>
</Base>
